# ConfigGuideAgent 环境变量模板
#
# 用法：复制本文件为本目录下的 .env，再填写密钥。不要把填好的 .env 提交到 GitHub。
# 本模板里没有真实密钥。留空的项表示必须自己填，写了默认值的项可以直接沿用。
#
# 程序读取顺序：
# 1. 若本项目还放在 Hello-Agents 仓库里，先读仓库根目录的 .env（本目录上两级）
# 2. 再读本目录的 .env，非空值覆盖上一级
# 单独克隆本仓库时，只需要本目录这一份 .env。
#
# 命令和所需配置：
# python main.py --check-only    需要下面的「嵌入」和「Qdrant」，不调用对话模型
# python main.py --case ...      嵌入、Qdrant、对话模型都要
# python main.py                 同上

# ---------- 对话模型（跑配单用例时必填）----------
# 课程默认是 DeepSeek 的 OpenAI 兼容接口。
# 换成别的服务时，同时改模型名、密钥和地址。
LLM_MODEL_ID=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 单次请求最长等待秒数。撰写和质检会连续调用模型，建议不要低于 120。
LLM_TIMEOUT=120

# ---------- 文本嵌入（情景记忆必填，--check-only 也会用）----------
# dashscope 表示通义千问嵌入接口。本项目按 text-embedding-v3 跑过。
# EMBED_API_KEY 是嵌入专用密钥。它和 LLM_API_KEY 不是同一项，除非两家服务本来就共用一把密钥。
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=
# 可留空。使用服务商默认地址时不要填。只有自建或代理端点时才写。
EMBED_BASE_URL=

# ---------- Qdrant 云集群（情景记忆必填，--check-only 也会用）----------
# 在 Qdrant Cloud 控制台复制集群地址和 API Key。
# 地址形如 https://你的集群ID.区域.cloud.qdrant.io
# 不要把向量写进课程已有集合 hello_agents_vectors。
# 集合名不用在这里填，程序会固定使用 configguide_episodic。
QDRANT_URL=
QDRANT_API_KEY=
# 可留空，默认 cosine。
QDRANT_DISTANCE=cosine
# 可留空。连接超时秒数。
QDRANT_TIMEOUT=30
